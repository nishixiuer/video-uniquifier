{
  "name": "video-uniquifier-desktop",
  "version": "2.1.2",
  "private": true,
  "description": "Electron desktop frontend for Video Uniquifier",
  "author": "video-uniquifier contributors",
  "main": "dist-electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit",
    "package:python": "node scripts/build-python.mjs",
    "test": "vitest run",
    "test:python": "../.venv/bin/python -m pytest python/tests -q",
    "test:e2e": "playwright test",
    "package": "pnpm package:python && pnpm build && electron-builder"
  },
  "dependencies": {
    "@ant-design/icons": "^6.0.0",
    "antd": "^5.27.4",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.9.4",
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@electron-toolkit/tsconfig": "^1.0.1",
    "@playwright/test": "^1.56.0",
    "@tailwindcss/vite": "^4.1.14",
    "@types/node": "^24.7.2",
    "@types/react": "^19.1.14",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.4",
    "autoprefixer": "^10.4.21",
    "electron": "^38.2.1",
    "electron-builder": "^26.0.12",
    "electron-vite": "^4.0.1",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.1.14",
    "typescript": "^5.9.3",
    "vite": "^7.1.9",
    "vitest": "^3.2.4"
  },
  "build": {
    "appId": "com.video-uniquifier.desktop",
    "productName": "Video Uniquifier",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist-electron/**/*",
      "dist-preload/**/*",
      "dist/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "python/dist/video-uniquifier-python",
        "to": "python/video-uniquifier-python",
        "filter": [
          "**/*"
        ]
      }
    ],
    "mac": {
      "category": "public.app-category.video",
      "identity": null,
      "target": [
        "dmg"
      ]
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "linux": {
      "target": [
        "AppImage"
      ]
    }
  }
}
